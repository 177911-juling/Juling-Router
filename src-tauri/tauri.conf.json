{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juling Router",
  "version": "1.0.0",
  "identifier": "com.juling.router",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --host",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Juling Router",
        "width": 1150,
        "height": 790,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Juling Router Team",
    "copyright": "(c) 2026 Juling Router Team",
    "shortDescription": "Install, launch and switch models for AI coding tools",
    "longDescription": "Juling Router is a desktop hub for AI tools and models: one-click install and launch for Claude Code, Codex CLI, Cursor and more; a shared model catalog with account and quota management; a local OpenAI/Anthropic-compatible endpoint with automatic failover; and local LLMs. Windows, macOS and Linux.",
    "homepage": "https://www.177911.com/",
    "category": "DeveloperTool",
    "resources": ["../tools/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Juling Router"
      }
    }
  }
}
